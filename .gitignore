# Environment files and secrets
.env
.env.*
!.env.example
!.env.*.example

# Node / Next.js / NestJS
node_modules/
.pnpm-store/
.next/
dist/
coverage/
.turbo/
.nest/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Prisma generated client (regenerated by `prisma generate`)
apps/api/src/generated/

# Flutter / Dart
# Note: Flutter's `.metadata` file is intentionally tracked (used by `flutter` migrations).
.dart_tool/
.packages
.pub-cache/
build/
.flutter-plugins
.flutter-plugins-dependencies

# FVM local SDK link/cache (the pinned version lives in .fvmrc, which is tracked)
.fvm/

# Mobile signing material
*.jks
*.keystore
**/android/key.properties

# IDEs and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local databases, logs and generated files
*.log
*.sqlite
*.sqlite3
*.db
*.pem
*.key

# Local Claude settings may contain machine-specific configuration
.claude/settings.local.json

# Instagram media (PNG/MP4) lives in the marketing folder (brand.json mediaDir), not in git
marketing/instagram/output/**/*.png
marketing/instagram/output/**/*.mp4
