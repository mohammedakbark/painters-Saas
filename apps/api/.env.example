# Copy to apps/api/.env for local development. Placeholder values only.
# Never commit a real .env file.

# development | test | production
NODE_ENV=development
PORT=3000

# Local Docker Postgres (see infra/local/.env). Use the same user/password you set there.
DATABASE_URL=postgresql://paintshop:change-me-local-only@localhost:5432/paintshop_dev

# Supabase Auth. Local stack: `pnpm supabase:keys && pnpm supabase:start` (see infra/supabase).
# Access tokens are verified with the JWKS (asymmetric keys only); there is no JWT secret here.
AUTH_ISSUER=http://127.0.0.1:54321/auth/v1
AUTH_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
AUTH_AUDIENCE=authenticated

# Server-only admin access to Supabase Auth (creating accounts). Local value: the
# "Secret" key printed by `pnpm supabase:status`. Never put it in a client app.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=replace-with-the-local-secret-key

# Object storage for public shop images, through the S3 protocol (ADR 0007).
# Local Supabase Storage (`pnpm supabase:start`): the values come from
# `pnpm supabase:status` ("S3 Access Key", "S3 Secret Key", "S3 Region").
# The keys are server-only credentials: never put them in a client app.
STORAGE_S3_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3
STORAGE_S3_REGION=local
STORAGE_S3_ACCESS_KEY_ID=replace-with-the-local-s3-access-key
STORAGE_S3_SECRET_ACCESS_KEY=replace-with-the-local-s3-secret-key
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_BUCKET=shop-media
# Image URLs returned by the API are this prefix plus the object key.
STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:54321/storage/v1/object/public/shop-media
