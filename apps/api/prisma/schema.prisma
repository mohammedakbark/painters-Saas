// Prisma Migrate owns the application schema in this database.
// Tables are added feature by feature, each with a reviewed migration
// (see docs/TECHNICAL_ARCHITECTURE.md). Do not add placeholder models.
//
// Conventions (ADR 0006):
// - Primary keys are UUIDv7 (time-ordered) generated by Prisma.
// - Timestamps are timestamptz with millisecond precision.
// - Every migration enables Row Level Security on new tables (defense in depth; ADR 0005).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity (AUTH-001)
// ---------------------------------------------------------------------------

/// Global login identity. One row per Supabase Auth user. Not tenant-owned.
model User {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Subject (`sub`) of the identity provider's access token (Supabase Auth user id).
  authSubject String   @unique @map("auth_subject") @db.Uuid
  /// E.164, for example +919999900001.
  phone       String?  @unique
  /// Lower case.
  email       String?  @unique
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  platformAdmin PlatformAdmin?
  auditEvents   AuditEvent[]

  @@map("users")
}

enum PlatformRole {
  SUPER_ADMIN

  @@map("platform_role")
}

/// Platform-level permission. Separate from shop membership by design.
model PlatformAdmin {
  userId    String       @id @map("user_id") @db.Uuid
  role      PlatformRole
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("platform_admins")
}

// ---------------------------------------------------------------------------
// Audit (AUTH-001)
// ---------------------------------------------------------------------------

enum AuditActorType {
  USER
  /// Operator scripts and other non-user actors.
  SYSTEM

  @@map("audit_actor_type")
}

/// Append-only record of sensitive actions. Metadata must never contain
/// passwords, tokens, OTPs, phone numbers or other sensitive values.
model AuditEvent {
  id          String         @id @default(uuid(7)) @db.Uuid
  occurredAt  DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorType   AuditActorType @map("actor_type")
  actorUserId String?        @map("actor_user_id") @db.Uuid
  /// Dotted action name, for example `platform_admin.granted`.
  action      String
  entityType  String         @map("entity_type")
  entityId    String         @map("entity_id")
  /// Owning shop for tenant-scoped events.
  shopId      String?        @map("shop_id") @db.Uuid
  metadata    Json?

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([shopId, occurredAt])
  @@index([entityType, entityId])
  @@map("audit_events")
}
