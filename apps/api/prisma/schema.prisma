// Prisma Migrate owns the application schema in this database.
// Tables are added feature by feature, each with a reviewed migration
// (see docs/TECHNICAL_ARCHITECTURE.md). Do not add placeholder models.
//
// Conventions (ADR 0006):
// - Primary keys are UUIDv7 (time-ordered) generated by Prisma.
// - Timestamps are timestamptz with millisecond precision.
// - Every migration enables Row Level Security on new tables (defense in depth; ADR 0005).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Identity (AUTH-001)
// ---------------------------------------------------------------------------

/// Global login identity. One row per Supabase Auth user. Not tenant-owned.
model User {
  id          String   @id @default(uuid(7)) @db.Uuid
  /// Subject (`sub`) of the identity provider's access token (Supabase Auth user id).
  authSubject String   @unique @map("auth_subject") @db.Uuid
  /// E.164, for example +919999900001.
  phone       String?  @unique
  /// Lower case.
  email       String?  @unique
  displayName String?  @map("display_name")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  platformAdmin    PlatformAdmin?
  auditEvents      AuditEvent[]
  shopMemberships  ShopMembership[]
  reviewsSubmitted ShopReview[]     @relation("ShopReviewSubmittedBy")
  reviewsDecided   ShopReview[]     @relation("ShopReviewDecidedBy")

  @@map("users")
}

enum PlatformRole {
  SUPER_ADMIN

  @@map("platform_role")
}

/// Platform-level permission. Separate from shop membership by design.
model PlatformAdmin {
  userId    String       @id @map("user_id") @db.Uuid
  role      PlatformRole
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("platform_admins")
}

// ---------------------------------------------------------------------------
// Audit (AUTH-001)
// ---------------------------------------------------------------------------

enum AuditActorType {
  USER
  /// Operator scripts and other non-user actors.
  SYSTEM

  @@map("audit_actor_type")
}

/// Append-only record of sensitive actions. Metadata must never contain
/// passwords, tokens, OTPs, phone numbers or other sensitive values.
model AuditEvent {
  id          String         @id @default(uuid(7)) @db.Uuid
  occurredAt  DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorType   AuditActorType @map("actor_type")
  actorUserId String?        @map("actor_user_id") @db.Uuid
  /// Dotted action name, for example `platform_admin.granted`.
  action      String
  entityType  String         @map("entity_type")
  entityId    String         @map("entity_id")
  /// Owning shop for tenant-scoped events.
  shopId      String?        @map("shop_id") @db.Uuid
  metadata    Json?

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  shop  Shop? @relation(fields: [shopId], references: [id], onDelete: Restrict)

  @@index([shopId, occurredAt])
  @@index([entityType, entityId])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// Shops and membership (SHP-001)
// ---------------------------------------------------------------------------

/// Lifecycle of a shop. New shops are drafts and are never visible to
/// customers. Review and approval statuses arrive with that feature.
/// Shop lifecycle (D-025, PLT-002). Only ACTIVE shops are shown to customers
/// and painters (later features).
enum ShopStatus {
  DRAFT
  /// Submitted; profile, photo and location are locked (D-033).
  PENDING_REVIEW
  /// The platform asked for changes (D-032); the owner fixes and resubmits.
  CHANGES_REQUESTED
  /// Approved by a platform admin ("Live").
  ACTIVE

  @@map("shop_status")
}

enum ShopReviewDecision {
  APPROVED
  CHANGES_REQUESTED
  /// The owner withdrew the submission to edit the shop.
  WITHDRAWN

  @@map("shop_review_decision")
}

/// Reasons a platform admin gives when requesting changes (D-032).
enum ShopReviewReason {
  PHOTO_MISSING_OR_UNCLEAR
  LOCATION_MISSING_OR_WRONG
  ADDRESS_INCOMPLETE
  SUPPORT_PHONE_INVALID
  PRODUCTS_INSUFFICIENT
  PRODUCT_DETAILS_INCORRECT
  /// Requires a note.
  OTHER

  @@map("shop_review_reason")
}

/// How the shop's map location was set (SHP-003).
enum ShopLocationSource {
  /// Placed or moved on the map, or chosen from a place search.
  MAP_PIN
  /// The device's current location (browser or Shop App).
  DEVICE_GPS

  @@map("shop_location_source")
}

/// The tenant. Every shop-owned record references a shop.
model Shop {
  id        String     @id @default(uuid(7)) @db.Uuid
  /// Trimmed, 2–120 characters (CHECK constraint in the migration).
  name      String
  status    ShopStatus @default(DRAFT)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Profile (SHP-003). Nullable while the shop is a draft; the onboarding
  // checklist reports what is missing. CHECK constraints in the migration.

  /// Customer-support mobile, E.164 (+91…). Not shown to customers yet (question 39).
  supportPhone      String?             @map("support_phone")
  /// The address fields are set and cleared together (CHECK constraint).
  addressLine1      String?             @map("address_line1")
  addressLine2      String?             @map("address_line2")
  landmark          String?
  city              String?
  district          String?
  /// Two-letter state/UT code (ISO 3166-2:IN subdivision part), for example KL.
  stateCode         String?             @map("state_code")
  /// Indian PIN code, 6 digits.
  postalCode        String?             @map("postal_code")
  /// Latitude, longitude and source are set together (CHECK constraint).
  latitude          Decimal?            @db.Decimal(9, 6)
  longitude         Decimal?            @db.Decimal(9, 6)
  locationSource    ShopLocationSource? @map("location_source")
  locationUpdatedAt DateTime?           @map("location_updated_at") @db.Timestamptz(3)
  profileUpdatedAt  DateTime?           @map("profile_updated_at") @db.Timestamptz(3)

  // Photo (SHP-004). Object key prefix in the public bucket; the API stores
  // "<key>-1600.webp" and "<key>-480.webp". Never a URL (ADR 0007).
  photoKey       String?   @map("photo_key")
  photoUpdatedAt DateTime? @map("photo_updated_at") @db.Timestamptz(3)

  memberships     ShopMembership[]
  auditEvents     AuditEvent[]
  products        ShopProduct[]
  shades          ShopShade[]
  favouriteShades ShopFavouriteShade[]
  reviews         ShopReview[]

  @@map("shops")
}

/// Shop roles. MASTER is the protected owner account (one per shop, partial
/// unique index in the migration). Staff roles arrive with staff management.
enum ShopRole {
  MASTER

  @@map("shop_role")
}

/// Links a user to a shop. The only source of shop authorization.
model ShopMembership {
  id        String   @id @default(uuid(7)) @db.Uuid
  shopId    String   @map("shop_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      ShopRole
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([shopId, userId])
  @@index([userId])
  @@map("shop_memberships")
}

// ---------------------------------------------------------------------------
// Brand catalogue (CAT-001). Maintained by platform admins and shared by all
// shops (D-030). Not tenant-owned: shops list these products with their own
// prices and availability (CAT-002). CHECK constraints in the migration.
// ---------------------------------------------------------------------------

enum PackUnit {
  LITRE
  MILLILITRE
  KILOGRAM
  GRAM
  PIECE

  @@map("pack_unit")
}

/// Product category, for example "Interior emulsion".
model CatalogueCategory {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// Trimmed, 2–60 characters.
  name      String
  /// lower(name): names are unique regardless of case.
  nameKey   String   @unique @map("name_key")
  sortOrder Int      @default(0) @map("sort_order")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products     CatalogueProduct[]
  shopProducts ShopProduct[]

  @@map("catalogue_categories")
}

/// A paint manufacturer, for example a brand whose shade card shops use.
model Brand {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// Trimmed, 2–80 characters.
  name      String
  nameKey   String   @unique @map("name_key")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  products     CatalogueProduct[]
  shades       Shade[]
  shopProducts ShopProduct[]
  shopShades   ShopShade[]

  @@map("brands")
}

/// A brand's product line, for example an interior emulsion. MRP and selling
/// prices belong to each shop's listing (CAT-002), because they change.
model CatalogueProduct {
  id             String    @id @default(uuid(7)) @db.Uuid
  brandId        String    @map("brand_id") @db.Uuid
  categoryId     String    @map("category_id") @db.Uuid
  /// Trimmed, 2–120 characters; unique per brand regardless of case.
  name           String
  nameKey        String    @map("name_key")
  description    String?
  /// True when the customer picks a shade (tinted or ready-mixed colours).
  supportsShades Boolean   @default(false) @map("supports_shades")
  active         Boolean   @default(true)
  /// Image key prefix in the public bucket (ADR 0007); never a URL.
  imageKey       String?   @map("image_key")
  imageUpdatedAt DateTime? @map("image_updated_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  brand    Brand             @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category CatalogueCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  packs    CataloguePack[]
  listings ShopProduct[]

  @@unique([brandId, nameKey])
  @@index([categoryId])
  @@index([brandId, name])
  @@map("catalogue_products")
}

/// A pack size of a product, for example 4 L.
model CataloguePack {
  id        String   @id @default(uuid(7)) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Decimal  @db.Decimal(10, 3)
  unit      PackUnit
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product   CatalogueProduct  @relation(fields: [productId], references: [id], onDelete: Restrict)
  shopPacks ShopProductPack[]

  @@unique([productId, quantity, unit])
  @@map("catalogue_packs")
}

/// A brand's shade (colour) with its code from the brand's shade card.
model Shade {
  id         String   @id @default(uuid(7)) @db.Uuid
  brandId    String   @map("brand_id") @db.Uuid
  /// Upper case, as printed on the shade card; unique per brand.
  code       String
  name       String
  /// Indicative screen colour (#RRGGBB); paint colours look different on screens.
  previewHex String?  @map("preview_hex")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  brand      Brand                @relation(fields: [brandId], references: [id], onDelete: Restrict)
  favourites ShopFavouriteShade[]

  @@unique([brandId, code])
  @@index([brandId, name])
  @@map("shades")
}

// ---------------------------------------------------------------------------
// Shop catalogue (CAT-002). Tenant-owned: every row carries shop_id, and packs
// reference their product through (shop_id, shop_product_id), so a pack can
// never point at another shop's product (ADR 0008). CHECKs in the migration.
// ---------------------------------------------------------------------------

enum ShopProductStatus {
  ACTIVE
  ARCHIVED

  @@map("shop_product_status")
}

/// A product a shop sells: either a brand-catalogue product (catalogueProductId)
/// or the shop's own product (the custom* fields and categoryId).
model ShopProduct {
  id                 String            @id @default(uuid(7)) @db.Uuid
  shopId             String            @map("shop_id") @db.Uuid
  /// Set for products from the brand catalogue; null for the shop's own.
  catalogueProductId String?           @map("catalogue_product_id") @db.Uuid
  /// Own products only. Trimmed, 2–120 characters.
  customName         String?           @map("custom_name")
  /// lower(custom_name): own product names are unique per shop.
  customNameKey      String?           @map("custom_name_key")
  /// Own products: a catalogue brand, or a free-text brand, or neither.
  brandId            String?           @map("brand_id") @db.Uuid
  customBrandName    String?           @map("custom_brand_name")
  /// Own products only (catalogue products use their catalogue category).
  categoryId         String?           @map("category_id") @db.Uuid
  description        String?
  supportsShades     Boolean?          @map("supports_shades")
  status             ShopProductStatus @default(ACTIVE)
  /// The shop's own photo (optional); otherwise the catalogue image is shown.
  imageKey           String?           @map("image_key")
  imageUpdatedAt     DateTime?         @map("image_updated_at") @db.Timestamptz(3)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop             Shop               @relation(fields: [shopId], references: [id], onDelete: Restrict)
  catalogueProduct CatalogueProduct?  @relation(fields: [catalogueProductId], references: [id], onDelete: Restrict)
  brand            Brand?             @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category         CatalogueCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  packs            ShopProductPack[]

  @@unique([shopId, id])
  @@unique([shopId, catalogueProductId])
  @@unique([shopId, customNameKey])
  @@index([shopId, status])
  @@map("shop_products")
}

/// A pack size a shop sells, with its price and availability (D-029).
/// Catalogue products use cataloguePackId; own products quantity + unit.
model ShopProductPack {
  id              String    @id @default(uuid(7)) @db.Uuid
  shopId          String    @map("shop_id") @db.Uuid
  shopProductId   String    @map("shop_product_id") @db.Uuid
  cataloguePackId String?   @map("catalogue_pack_id") @db.Uuid
  quantity        Decimal?  @db.Decimal(10, 3)
  unit            PackUnit?
  /// Maximum retail price in paise (optional). Integer money, never floats.
  mrpPaise        Int?      @map("mrp_paise")
  /// Selling price in paise.
  pricePaise      Int       @map("price_paise")
  /// Unavailable packs cannot be bought or added to a cart (D-029).
  available       Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  product       ShopProduct    @relation(fields: [shopId, shopProductId], references: [shopId, id], onDelete: Restrict)
  cataloguePack CataloguePack? @relation(fields: [cataloguePackId], references: [id], onDelete: Restrict)

  @@unique([shopProductId, cataloguePackId])
  @@unique([shopProductId, quantity, unit])
  @@index([shopId])
  @@map("shop_product_packs")
}

/// A shade code of the shop's own (not on a brand shade card).
model ShopShade {
  id         String   @id @default(uuid(7)) @db.Uuid
  shopId     String   @map("shop_id") @db.Uuid
  brandId    String?  @map("brand_id") @db.Uuid
  /// Upper case; unique per shop.
  code       String
  name       String
  previewHex String?  @map("preview_hex")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop  Shop   @relation(fields: [shopId], references: [id], onDelete: Restrict)
  brand Brand? @relation(fields: [brandId], references: [id], onDelete: Restrict)

  @@unique([shopId, code])
  @@map("shop_shades")
}

/// A brand shade the shop commonly uses (shown first to its customers).
model ShopFavouriteShade {
  shopId    String   @map("shop_id") @db.Uuid
  shadeId   String   @map("shade_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  shop  Shop  @relation(fields: [shopId], references: [id], onDelete: Restrict)
  shade Shade @relation(fields: [shadeId], references: [id], onDelete: Restrict)

  @@id([shopId, shadeId])
  @@index([shadeId])
  @@map("shop_favourite_shades")
}

/// One submission of a shop for platform review and its outcome (PLT-002).
/// CHECKs in the plt_002 migrations keep decision, reasons and note
/// consistent.
model ShopReview {
  id                String              @id @default(uuid(7)) @db.Uuid
  shopId            String              @map("shop_id") @db.Uuid
  /// Equals shop_id while the review is open and is null once decided, so
  /// the plain unique index allows one open review per shop.
  openShopId        String?             @unique @map("open_shop_id") @db.Uuid
  /// The status the shop returns to if the owner withdraws.
  submittedFrom     ShopStatus          @map("submitted_from")
  submittedByUserId String              @map("submitted_by_user_id") @db.Uuid
  submittedAt       DateTime            @default(now()) @map("submitted_at") @db.Timestamptz(3)
  decision          ShopReviewDecision?
  /// The platform admin who decided, or the owner who withdrew.
  decidedByUserId   String?             @map("decided_by_user_id") @db.Uuid
  decidedAt         DateTime?           @map("decided_at") @db.Timestamptz(3)
  reasons           ShopReviewReason[]  @default([])
  /// Shown to the owner. Required with the OTHER reason; at most 1,000 characters.
  note              String?

  shop        Shop  @relation(fields: [shopId], references: [id], onDelete: Restrict)
  submittedBy User  @relation("ShopReviewSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  decidedBy   User? @relation("ShopReviewDecidedBy", fields: [decidedByUserId], references: [id], onDelete: Restrict)

  @@index([shopId, submittedAt])
  @@index([decision, submittedAt])
  @@map("shop_reviews")
}
