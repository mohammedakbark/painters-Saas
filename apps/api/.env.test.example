# Copy to apps/api/.env.test. Used only by `pnpm --filter api test:e2e`.
# Points at the separate test database created by infra/local/postgres/init.
# The e2e suites refuse any database whose name does not contain "test".
NODE_ENV=test
DATABASE_URL=postgresql://paintshop:change-me-local-only@localhost:5432/paintshop_test

# The e2e tests sign their own tokens and use an in-memory identity provider,
# so these values only need to be well-formed. Nothing is contacted.
AUTH_ISSUER=http://auth.test.invalid/auth/v1
AUTH_JWKS_URL=http://auth.test.invalid/auth/v1/.well-known/jwks.json
SUPABASE_URL=http://auth.test.invalid
SUPABASE_SECRET_KEY=test-only-not-a-secret
