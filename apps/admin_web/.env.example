# Copy to apps/admin_web/.env.local for local development. Placeholder values only.
#
# Rules for this app:
# - Only NEXT_PUBLIC_* variables reach the browser. This app has none: sign-in
#   runs in Server Actions and the API is called only from the server.
# - Never put the Supabase SECRET key here. The portal needs only the
#   publishable key; the secret key belongs to apps/api.

# Local Supabase Auth (`pnpm supabase:start`). The publishable key is printed
# by `pnpm supabase:status` ("Publishable").
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-the-local-publishable-key

# NestJS API (server-side calls only).
API_BASE_URL=http://localhost:3000

# Google Maps for the shop address picker (SHP-003). Optional: leave empty and
# the profile page uses typed address fields and "Use my current location".
# The browser key is PUBLIC by design (it is sent to the browser): restrict it
# in Google Cloud to HTTP referrers of this portal and to the Maps JavaScript,
# Places (New) and Geocoding APIs. See docs/guides/GOOGLE_MAPS_SETUP.md.
GOOGLE_MAPS_BROWSER_KEY=
# Map ID for advanced markers; Google's demo map ID is used when empty.
GOOGLE_MAPS_MAP_ID=
