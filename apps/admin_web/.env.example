# Copy to apps/admin_web/.env.local for local development. Placeholder values only.
# No variables are read by the foundation build yet.
#
# Rules for this app:
# - Only NEXT_PUBLIC_* variables reach the browser. Never put secrets in them.
# - Server-only values (for example the API base URL used by server components)
#   must not use the NEXT_PUBLIC_ prefix.
#
# Reserved for the first feature that calls the API (server-side only):
# API_BASE_URL=http://localhost:3000
