# Local Docker Postgres settings. Copy to infra/local/.env and change the password.
# These values are for a localhost-only development container, never for production.
POSTGRES_USER=paintshop
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=paintshop_dev
# Separate database used by automated API integration tests.
POSTGRES_TEST_DB=paintshop_test
POSTGRES_PORT=5432
